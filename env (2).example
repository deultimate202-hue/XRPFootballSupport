# ======================================================================
# Use the SAME variables you already have. Nothing new is required.
# ======================================================================

TELEGRAM_BOT_TOKEN=your_token_from_botfather

# Your AI key. Any of these names work: AI_API_KEY, GROQ_API_KEY or OPENAI_API_KEY.
# The provider is detected from the key itself:
#   gsk_...  -> Groq (free)      sk-...  -> OpenAI
OPENAI_API_KEY=your_ai_key

# Your two Telegram chats (negative numbers for groups, e.g. -1001234567890).
# Optional: if you leave them out, send /setgroup in the public group and
# /setadmin in the staff group once the bot is running.
TARGET_GROUP_ID=-1001234567890
ADMIN_CHAT_ID=-1009876543210

# Leagues. Your usual numbers work as they are (39=Premier League, 140=La Liga,
# 135=Serie A, 78=Bundesliga, 61=Ligue 1, 2=Champions League, 3=Europa League).
LEAGUE_IDS=39,140,2

# FOOTBALL_API_KEY is NOT needed: live scores come from a free feed with no key.
# (If the variable is already set on your host, it is simply ignored.)
# FOOTBALL_API_KEY=

# ---------------------- everything below is optional ----------------------
# TIMEZONE=Africa/Lagos          # kickoff times in previews
# STATE_DIR=/data                # point at a persistent disk so the bot remembers tickets/settings
# AI_MODEL=                      # normally auto-selected; retired models are replaced automatically
# OWNER_USER_ID=                 # your Telegram user ID (who may run /setgroup, /setadmin)
