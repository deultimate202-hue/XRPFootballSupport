# ---------- REQUIRED ----------
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather
# Free AI key from https://console.groq.com/keys (no credit card needed)
AI_API_KEY=gsk_...
# Public group where goal alerts / previews are auto-posted (negative number, supergroups start with -100)
TARGET_GROUP_ID=-1001234567890
# Private staff group where support tickets arrive
ADMIN_CHAT_ID=-1009876543210

# ---------- LIVE SCORES (no account / no key needed) ----------
# espn      = free ESPN public scoreboard (default, keyless, unofficial)
# direct    = API-Football via dashboard.api-football.com  (needs FOOTBALL_API_KEY)
# rapidapi  = API-Football via RapidAPI                    (needs FOOTBALL_API_KEY)
FOOTBALL_API_PROVIDER=espn
# FOOTBALL_API_KEY=            # only for direct / rapidapi

# Leagues to monitor.
#  ESPN slugs:  eng.1=Premier League, esp.1=La Liga, ita.1=Serie A, ger.1=Bundesliga, fra.1=Ligue 1,
#               uefa.champions=Champions League, uefa.europa=Europa League, usa.1=MLS
#  (API-Football providers use numeric IDs instead: 39,140,2 ...)
LEAGUE_IDS=eng.1,esp.1,uefa.champions

# ---------- OPTIONAL ----------
# AI provider: any OpenAI-compatible endpoint. Defaults below = Groq (free).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
# Used automatically if the main model hits its free rate limit (leave empty to disable)
AI_FALLBACK_MODEL=llama-3.3-70b-versatile
TIMEZONE=UTC                    # e.g. Africa/Lagos, Europe/London - used for kickoff times in previews
POLL_INTERVAL_SECONDS=60
PREVIEW_MINUTES_BEFORE=60
SCHEDULE_REFRESH_MINUTES=120
ALWAYS_POLL=false               # true = poll live feed 24/7 (burns API quota)
MODERATION_ENABLED=true
STATE_DIR=./data                # mount a persistent volume here in production (Docker image uses /data)
LOG_LEVEL=INFO
